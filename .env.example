# ─────────────────────────────────────────────────────────────
# Painel ADM Larsil (IAM) — variáveis de ambiente
# Copie para `.env` no local; no Railway, cadastre cada uma em Variables.
# NUNCA comite o .env preenchido (já está no .gitignore).
# ─────────────────────────────────────────────────────────────

# Conexão com o Azure SQL (mesmo banco do Painel PCP).
# No Railway estas são OBRIGATÓRIAS (não há fallback pro .env do timbertrack lá).
DB_SERVER=alrflorestal.database.windows.net
DB_DATABASE=Tabela_teste
DB_USER=
DB_PASSWORD=
DB_PORT=1433

# Schema onde as tabelas IAM vivem (isolado do dbo).
IAM_SCHEMA=iam

# Porta: LOCAL usa AUTH_PORT (4000). No Railway NÃO defina — ele injeta PORT sozinho.
AUTH_PORT=4000

# Assinatura do token. TEM QUE SER IGUAL ao JWT_SECRET do Painel PCP no Railway,
# senão o PCP rejeita o login. (o IAM assina, o PCP valida com o mesmo segredo)
JWT_SECRET=
JWT_EXPIRA=12h

# Logins que podem entrar no console /admin (TI). Separados por vírgula.
ADMIN_LOGINS=eduardo.ferreira
